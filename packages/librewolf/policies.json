          "Alias": "@g"
        },
        {
          "Name": "Nix Packages",
          "URLTemplate": "https://search.nixos.org/packages?type=packages&channel=unstable&query={searchTerms}",
          "Alias": "@np"
        },
        {
          "Name": "YouTube",
          "URLTemplate": "https://www.youtube.com/results?search_query={searchTerms}",
          "Alias": "@yt"
        }
      ]
    }
  }
